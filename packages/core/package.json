{
  "name": "@modelport/core",
  "version": "0.1.0",
  "description": "Provider adapters, model discovery and one-use human approvals for multimodal AI.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "files": ["dist", "src"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./catalog": { "types": "./dist/catalog.d.ts", "import": "./dist/catalog.js" },
    "./policy": { "types": "./dist/policy.d.ts", "import": "./dist/policy.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "ipaddr.js": "2.5.0", "zod": "4.6.7" }
}
